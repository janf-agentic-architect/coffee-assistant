# Local development configuration template
# In production:
# - ADK_API_URL is dynamically generated by Terraform pointing to the Vertex AI Reasoning Engine.
# - WHATSAPP_* secrets are retrieved directly from GCP Secret Manager by Cloud Run.

# Local Agent server (in production, this is the Cloud Reasoning Engine endpoint)
ADK_API_URL=http://localhost:8080
ADK_APP_NAME=app

# WhatsApp credentials for local testing (in production, managed via Secret Manager)
WHATSAPP_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_VERIFY_TOKEN=tu_token_de_verificacion_para_el_webhook
# WHATSAPP_APP_SECRET=tu_app_secret_de_meta
