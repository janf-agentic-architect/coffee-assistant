# Local development configuration template (Meta WhatsApp Cloud API)
# In production (and local fallback):
# - Set `whatsapp_token` and `whatsapp_app_secret` in `infra/vars/env.tfvars`.
# - `make infra` automatically populates GCP Secret Manager (`whatsapp-token`, `whatsapp-app-secret`,
#   auto-generated `whatsapp-verify-token`, and `whatsapp-phone-number-id`).
# - ADK_API_URL is dynamically injected by Terraform pointing to the Vertex AI Reasoning Engine.

# Local Agent server
ADK_API_URL=http://localhost:8080
ADK_APP_NAME=app

# Optional local overrides (if omitted, automatically read from infra/vars/env.tfvars)
# WHATSAPP_TOKEN=EAAG...
# WHATSAPP_APP_SECRET=tu_app_secret_de_meta
# WHATSAPP_PHONE_NUMBER_ID=123456789012345
# WHATSAPP_VERIFY_TOKEN=tu_token_de_verificacion_para_el_webhook
