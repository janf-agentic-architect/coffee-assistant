# Project name used for resource naming
project_name = "coffee-assistant"

# The Google Cloud region you will use to deploy the infrastructure
region = "us-east1"

# ==============================================================================
# OPTION 1: Automatic GCP Project Creation
# ==============================================================================
# Set create_project = true to automatically create a new GCP project and use its ID.
# When create_project = true, billing_account is required.
# create_project  = true
# billing_account = "012345-6789AB-CDEF01"
# org_id          = "123456789012" # Optional: Organization ID
# folder_id       = "123456789012" # Optional: Folder ID

# ==============================================================================
# OPTION 2: Use an Existing GCP Project
# ==============================================================================
# If create_project = false, provide your existing Google Cloud project ID:
project_id = "your-gcp-project-id"
