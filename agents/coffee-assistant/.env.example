# Local development configuration template
# By default, local development uses the Google AI Studio (Gemini Developer API).
# In production (Vertex AI Agent Runtime):
# - GOOGLE_CLOUD_PROJECT is automatically injected by Vertex AI Agent Runtime.
# - GOOGLE_GENAI_USE_ENTERPRISE=True and GOOGLE_CLOUD_LOCATION=global are injected by Terraform.
# - Upstash Redis secrets are mounted from GCP Secret Manager (upstash-redis-url / upstash-redis-token).

# Google AI Studio API Key (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your-google-ai-studio-api-key

# Model override (defaults to gemini-3.5-flash-lite)
MODEL=gemini-3.5-flash-lite

# Disable rate limiting in local development (defaults to true in production; not synced to GCP Secret Manager)
RATE_LIMIT_ENABLED=false

# Optional: Use Vertex AI locally instead of Google AI Studio (requires `gcloud auth application-default login`)
# GOOGLE_GENAI_USE_ENTERPRISE=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global

# Upstash Redis (Optional in local development; fallback is in-memory rate limiting)
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token-here
