# Local development configuration template
# Variables that change between local development and production.
# In production, database credentials and cloud endpoints are managed via Secret Manager / Cloudflare.

# Local PostgreSQL (Docker) vs Neon in production
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coffee_assistant_db

# Local Agent server vs Reasoning Engine in production
AGENT_RUNTIME_API_URL=http://localhost:8080
